# ============================================
# VROOM REPUESTOS EXPRESS - Variables de Entorno
# ============================================

# Puerto del servidor (default: 3000)
PORT=3000

# Entorno (development, production)
NODE_ENV=development

# Nivel de logs (debug, info, warn, error)
LOG_LEVEL=info

# Dominio/URL de origen CORS
CORS_ORIGIN=http://localhost:5173

# ============================================
# BASE DE DATOS PostgreSQL
# ============================================
# Formato: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://vroom:vroom123@localhost:5432/vroom_db

# ============================================
# REDIS
# ============================================
# Formato: redis://host:port
REDIS_URL=redis://localhost:6379

# ============================================
# AUTENTICACIÓN JWT
# ============================================
# Clave secreta para firmar tokens JWT (cambiar en producción)
JWT_SECRET=vroom-jwt-secret-change-in-production-please

# ============================================
# TASA BCV (Dólar)
# ============================================
# Tasa de fallback si el API de BCV no responde
# Valor aproximado: 50 BS/USD
BCV_FALLBACK_RATE=50

# ============================================
# PAGOS (Pago Móvil)
# ============================================
# Teléfono de Pago Móvil de VROOM (para recibir pagos)
PAGO_MOVIL_PHONE=04141234567

# Banco para Pago Móvil (nombre completo)
PAGO_MOVIL_BANK=Banco de Venezuela

# ============================================
# SOCKET.IO
# ============================================
# Token secreto para Socket.io (opcional)
SOCKET_SECRET=

# ============================================
# OPCIONALES
# ============================================
# URL de la aplicación (para callbacks)
APP_URL=http://localhost:3000

# Host para escuchar (0.0.0.0 para producción)
HOST=0.0.0.0