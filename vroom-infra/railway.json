{
  "$schema": "https:// Railway schema",
  "build": {
    "builder": "NIXPACKS",
    "config": {
      "nodeVersion": "20"
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  " Railway": {
    "id": "vroom-repuestos-api",
    "name": "VROOM API",
    "region": "us-east"
  },
  "Environment": [
    {
      "key": "NODE_ENV",
      "value": "production"
    },
    {
      "key": "PORT",
      "value": "3000"
    }
  ],
  "Health Check": {
    "path": "/health",
    "interval": 30,
    "timeout": 10,
    "failureThreshold": 3
  },
  " Nixpacks": {
    "install": [
      "npm ci --only=production"
    ],
    "build": [
      "npm run build"
    ],
    "start": "node dist/index.js"
  }
}